  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie": "^0.7.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.5.4"
  }
}
